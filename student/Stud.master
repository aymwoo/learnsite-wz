<%@ Master Language="C#"   AutoEventWireup="true" CodeFile="Stud.master.cs" Inherits="Student_Stud" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" >
<head id="Head1" runat="server">
    <meta charset="UTF-8" />
    <title></title>
    <link href="../js/css/font-awesome.min.css" rel="stylesheet" type="text/css" />   
    <link href="../App_Themes/Student/StyleSheet.css?ver=621" rel="stylesheet" type="text/css" />
    <script src="../js/jquery-1.8.2.min.js" type="text/javascript"></script>        
    <link href="../js/tinybox.css" rel="stylesheet" type="text/css" />
    <script src="../js/tinybox.js" type="text/javascript"></script>
    <script type="text/javascript">
        function showShare() {
            var urlat = "../student/groupshare.aspx";
            TINY.box.show({ iframe: urlat, boxid: 'frameless', width: 600, height: 400, fixed: false, maskopacity: 60, close: true })
        }

        function showChat() {
            var urlat = "../student/chat.aspx";
            TINY.box.show({ iframe: urlat, boxid: 'frameless', width: 616, height: 515, fixed: false, maskopacity: 100, close: true });
        }
        function showRobot() {
            var urlat = "../deepseek/robot.html";
            TINY.box.show({ iframe: urlat, boxid: 'frameless', width: 616, height: 515, fixed: false, maskopacity: 100, close: true });
        }  
    </script>
    <script src="../js/ruffle.js" type="text/javascript"></script>
	<script type="text/javascript">
		window.RufflePlayer = window.RufflePlayer || {};
		window.RufflePlayer.config = {
			"autoplay": "on",
	}
	</script>
    
    <link href="https://cdn.bootcdn.net/ajax/libs/tailwindcss/2.2.19/utilities.min.css" rel="stylesheet">
</head>
<body class="bg-slate-50 font-sans text-slate-800 antialiased selection:bg-blue-100 selection:text-blue-900">
    <form id="form1" runat="server">
      <div class="min-h-screen flex flex-col relative overflow-hidden">
            <!-- Abstract background shape -->
            <div class="absolute top-0 inset-x-0 h-64 bg-gradient-to-b from-blue-100/50 to-transparent -z-10 pointer-events-none"></div>

            <!-- Solid Blue Modern Nav -->
            <header class="sticky top-0 z-50 w-full bg-blue-600 shadow-[0_4px_20px_rgba(37,99,235,0.3)] border-b border-blue-500/30 transition-all duration-300">
                <div class="mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex items-center justify-between h-20">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-2xl bg-white/20 backdrop-blur-md shadow-inner flex items-center justify-center text-white ring-1 ring-white/50">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                            </div>
                            <span class="text-xl font-black tracking-widest text-white drop-shadow-md">云端成长档案</span>
                        </div>
                        
                        <nav class="hidden md:flex flex-1 items-center justify-end space-x-1.5">
                            <a href="../student/mycourse.aspx" class="px-5 py-2.5 rounded-2xl text-[15px] font-bold text-blue-50 hover:text-white hover:bg-white/15 hover:shadow-sm hover:-translate-y-0.5 hover:underline hover:decoration-white/70 hover:decoration-2 hover:underline-offset-4 transition-all duration-300 ease-out active:scale-95">我的学案</a>
                            <a href="../student/mywork.aspx" class="px-5 py-2.5 rounded-2xl text-[15px] font-bold text-blue-50 hover:text-white hover:bg-white/15 hover:shadow-sm hover:-translate-y-0.5 hover:underline hover:decoration-white/70 hover:decoration-2 hover:underline-offset-4 transition-all duration-300 ease-out active:scale-95">我的作品</a>
                            <a href="../student/myfinger.aspx" class="px-5 py-2.5 rounded-2xl text-[15px] font-bold text-blue-50 hover:text-white hover:bg-white/15 hover:shadow-sm hover:-translate-y-0.5 hover:underline hover:decoration-white/70 hover:decoration-2 hover:underline-offset-4 transition-all duration-300 ease-out active:scale-95">打字宝典</a>
                            <a href="../student/myfile.aspx" class="px-5 py-2.5 rounded-2xl text-[15px] font-bold text-blue-50 hover:text-white hover:bg-white/15 hover:shadow-sm hover:-translate-y-0.5 hover:underline hover:decoration-white/70 hover:decoration-2 hover:underline-offset-4 transition-all duration-300 ease-out active:scale-95">在线资源</a>
                            <a onclick="showShare()" class="px-5 py-2.5 rounded-2xl text-[15px] font-bold text-blue-50 hover:text-white hover:bg-white/15 hover:shadow-sm hover:-translate-y-0.5 hover:underline hover:decoration-white/70 hover:decoration-2 hover:underline-offset-4 transition-all duration-300 ease-out active:scale-95 cursor-pointer">我的网盘</a>
                            <div class="h-6 w-px bg-blue-300/40 mx-2"></div>
                            <a href="../student/myinfo.aspx?action=logout" class="ml-2 px-5 py-2.5 rounded-2xl text-[14px] font-bold text-blue-600 bg-white hover:bg-blue-50 hover:text-blue-700 shadow-md hover:shadow-lg hover:shadow-white/20 hover:-translate-y-0.5 transition-all duration-300 ease-out active:scale-95 border-0">退出登录</a>
                        </nav>
                    </div>
                </div>
            </header>

            <!-- Main Content Area -->
            <main class="flex-1 w-full mx-auto p-4 sm:p-6 lg:p-8 z-10 w-full">
                <div class="path mb-2 text-sm text-slate-500 hidden">
                    &nbsp;
                </div>
                <div class="bg-white rounded-[1.25rem] shadow-sm border border-slate-200/60 p-4 sm:p-8 min-h-[calc(100vh-10rem)] w-full relative">
                    <asp:contentplaceholder id="Cphs" runat="server">
                    </asp:contentplaceholder>
                </div>
            </main>
        </div>
        <br />
		<div class="chatimg"  onclick="showChat()"  title="小组在线聊天" ></div>
		<div class="robotimg"  title="人工智能对话"   onclick="showRobot()" ></div>
    </form>
</body>
</html>
