<%@ Master Language="C#"   AutoEventWireup="true" CodeFile="Stud.master.cs" Inherits="Student_Stud" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" >
<head id="Head1" runat="server">
    <meta charset="UTF-8" />
    <title></title>
    <link href="../js/css/font-awesome.min.css" rel="stylesheet" type="text/css" />   
    <link href="../App_Themes/Student/StyleSheet.css?ver=621" rel="stylesheet" type="text/css" />
    <script src="../js/jquery-1.8.2.min.js" type="text/javascript"></script>        
    <link href="../js/tinybox.css" rel="stylesheet" type="text/css" />
    <script src="../js/tinybox.js" type="text/javascript"></script>
    <script type="text/javascript">
        function showShare() {
            var urlat = "../student/groupshare.aspx";
            TINY.box.show({ iframe: urlat, boxid: 'frameless', width: 600, height: 400, fixed: false, maskopacity: 60, close: true })
        }

        function showChat() {
            var urlat = "../student/chat.aspx";
            TINY.box.show({ iframe: urlat, boxid: 'frameless', width: 616, height: 515, fixed: false, maskopacity: 100, close: true });
        }
        function showRobot() {
            var urlat = "../deepseek/robot.html";
            TINY.box.show({ iframe: urlat, boxid: 'frameless', width: 616, height: 515, fixed: false, maskopacity: 100, close: true });
        }  
    </script>
    <script src="../js/ruffle.js" type="text/javascript"></script>
	<script type="text/javascript">
		window.RufflePlayer = window.RufflePlayer || {};
		window.RufflePlayer.config = {
			"autoplay": "on",
	}
	</script>
    
    <link href="https://cdn.bootcdn.net/ajax/libs/tailwindcss/2.2.19/utilities.min.css" rel="stylesheet">
</head>
<body class="bg-slate-50 font-sans text-slate-800 antialiased selection:bg-blue-100 selection:text-blue-900">
    <form id="form1" runat="server">
      <div class="min-h-screen flex flex-col relative overflow-hidden">
            <!-- Abstract background shape -->
            <div class="absolute top-0 inset-x-0 h-64 bg-gradient-to-b from-blue-100/50 to-transparent -z-10 pointer-events-none"></div>

            <!-- Glassmorphism Modern Nav -->
            <header class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/70 border-b border-slate-200/60 shadow-sm transition-all duration-300">
                <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex items-center justify-between h-16">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 shadow-md flex items-center justify-center text-white font-bold text-lg">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                            </div>
                            <span class="text-[1.15rem] font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-blue-700 to-indigo-600">云端成长档案</span>
                        </div>
                        
                        <nav class="hidden md:flex flex-1 items-center justify-end space-x-2">
                            <a href="../student/mycourse.aspx" class="px-4 py-2 rounded-xl text-[14px] font-semibold text-slate-600 hover:text-blue-700 hover:bg-blue-50 transition-all duration-300">我的学案</a>
                            <a href="../student/mywork.aspx" class="px-4 py-2 rounded-xl text-[14px] font-semibold text-slate-600 hover:text-blue-700 hover:bg-blue-50 transition-all duration-300">我的作品</a>
                            <a href="../student/myfinger.aspx" class="px-4 py-2 rounded-xl text-[14px] font-semibold text-slate-600 hover:text-blue-700 hover:bg-blue-50 transition-all duration-300">打字宝典</a>
                            <a href="../student/myfile.aspx" class="px-4 py-2 rounded-xl text-[14px] font-semibold text-slate-600 hover:text-blue-700 hover:bg-blue-50 transition-all duration-300">在线资源</a>
                            <a onclick="showShare()" class="px-4 py-2 rounded-xl text-[14px] font-semibold text-slate-600 hover:text-blue-700 hover:bg-blue-50 transition-all duration-300 cursor-pointer">我的网盘</a>
                            <a href="../index.aspx" class="ml-2 px-3 py-1.5 rounded-lg text-[13px] font-medium text-slate-400 border border-slate-200 hover:text-red-500 hover:border-red-200 transition-colors">退出</a>
                        </nav>
                    </div>
                </div>
            </header>

            <!-- Main Content Area -->
            <main class="flex-1 w-full max-w-[1400px] mx-auto p-4 sm:p-6 lg:p-8 z-10 w-full">
                <div class="path mb-2 text-sm text-slate-500 hidden">
                    &nbsp;
                </div>
                <div class="bg-white rounded-[1.25rem] shadow-sm border border-slate-200/60 p-4 sm:p-8 min-h-[calc(100vh-10rem)] w-full relative">
                    <asp:contentplaceholder id="Cphs" runat="server">
                    </asp:contentplaceholder>
                </div>
            </main>
        </div>
        <br />
		<div class="chatimg"  onclick="showChat()"  title="小组在线聊天" ></div>
		<div class="robotimg"  title="人工智能对话"   onclick="showRobot()" ></div>
    </form>
</body>
</html>
