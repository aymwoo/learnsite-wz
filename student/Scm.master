<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Scm.master.cs" Inherits="Student_Scm" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" >
<head id="Head1" runat="server">
    <meta charset="UTF-8" />
    <title></title>
    <link href="../js/css/font-awesome.min.css" rel="stylesheet" type="text/css" />   
    <link href="../App_Themes/Student/StyleSheet.css?ver=621" rel="stylesheet" type="text/css" />
    <script src="../js/jquery-1.8.2.min.js" type="text/javascript"></script>
    <script src="../kindeditor/plugins/code/prettify.js" type="text/javascript"></script>     
    <link href="../js/tinybox.css" rel="stylesheet" type="text/css" />
    <script src="../js/tinybox.js" type="text/javascript"></script>
    <script type="text/javascript">
            function showShare() {
                var urlat = "../student/groupshare.aspx";
                TINY.box.show({ iframe: urlat, boxid: 'frameless', width: 600, height: 400, fixed: false, maskopacity: 60, close: true });
            }
    </script>
   <script src="../js/ruffle.js" type="text/javascript"></script>
	<script type="text/javascript">
		window.RufflePlayer = window.RufflePlayer || {};
		window.RufflePlayer.config = {
			"autoplay": "on",
	}
	</script>

    <link href="https://cdn.bootcdn.net/ajax/libs/tailwindcss/2.2.19/utilities.min.css" rel="stylesheet">
</head>
<body onload="prettyPrint(); " class="bg-slate-50 font-sans text-slate-800 antialiased selection:bg-indigo-100 selection:text-indigo-900 overflow-x-hidden">
    <form id="form1" runat="server">
        <div class="min-h-screen flex flex-col relative w-full max-w-[100vw]">
            <!-- Dynamic Banner container (updated for modern fit) -->
            <div class="banner absolute top-0 inset-x-0 h-48 sm:h-64 bg-gradient-to-b from-indigo-100/60 to-transparent -z-10 bg-cover bg-center" style="opacity: 0.35; mix-blend-mode: multiply;"></div>

            <!-- Solid Blue Modern Nav -->
            <header class="sticky top-0 z-50 w-full bg-blue-600 shadow-[0_4px_20px_rgba(37,99,235,0.3)] border-b border-blue-500/30 transition-all duration-300">
                <div class="max-w-[1400px] mx-auto px-2 sm:px-6 lg:px-8">
                    <div class="flex items-center justify-center sm:justify-between h-16 sm:h-20 w-full custom-menu-wrapper">
                        <div class="hidden sm:flex items-center gap-4 flex-shrink-0">
                            <div class="w-10 h-10 rounded-2xl bg-white/20 backdrop-blur-md shadow-inner flex items-center justify-center text-white ring-1 ring-white/50">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253"></path></svg>
                            </div>
                        </div>
                        
                        <!-- Dynamic Course Menu -->
                        <div class="flex flex-1 items-center justify-center overflow-x-auto overflow-y-hidden custom-scrollbar">
                           <asp:Menu ID="Menuact" runat="server" Orientation="Horizontal" CssClass="flex flex-nowrap items-center min-w-max space-x-1 sm:space-x-2 py-1" ForeColor="#eff6ff">
                                <StaticSelectedStyle BackColor="rgba(255,255,255,0.25)" ForeColor="#ffffff" />
                                <StaticHoverStyle BackColor="rgba(255,255,255,0.15)" ForeColor="#ffffff" />
                                <StaticMenuItemStyle CssClass="px-3 sm:px-5 py-2 sm:py-2.5 mx-1 font-bold text-[14px] sm:text-[15px] transition-all duration-300 ease-out active:scale-95 rounded-2xl whitespace-nowrap hover:shadow-sm hover:-translate-y-0.5 hover:underline hover:decoration-white/70 hover:decoration-2 hover:underline-offset-4" />
                           </asp:Menu>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Main Content Area -->
            <main class="flex-1 w-full max-w-[1400px] mx-auto p-3 sm:p-6 lg:p-8 z-10 box-border">
                <div class="path mb-2 text-sm text-slate-500 hidden"></div>
                <div class="bg-white rounded-[1.25rem] shadow-sm border border-slate-200/60 p-4 sm:p-8 min-h-[calc(100vh-10rem)] relative w-full overflow-hidden">
                    <asp:contentplaceholder id="Cpcm" runat="server"></asp:contentplaceholder>
                </div>
            </main>
        </div>
    </form>   

	<script type="text/javascript" >
	    var cbanner = "<%=Cbanner %>";
	    if (cbanner != "") {
	        var bannerurl = "url("+cbanner+")";
	        $(".banner").css("background-image", bannerurl);
            $(".banner").css("opacity", "0.15"); /* soften custom images so text is readable */
	    }
    </script>
    <style>
        .custom-menu-wrapper table { margin: 0 auto; }
        .custom-menu-wrapper table td { padding: 0 4px; }
    </style>
</body>
</html>
