<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Scm.master.cs" Inherits="Student_Scm" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" >
<head id="Head1" runat="server">
    <meta charset="UTF-8" />
    <title></title>
    <link href="../js/css/font-awesome.min.css" rel="stylesheet" type="text/css" />   
    <link href="../App_Themes/Student/StyleSheet.css?ver=621" rel="stylesheet" type="text/css" />
    <script src="../js/jquery-1.8.2.min.js" type="text/javascript"></script>
    <script src="../kindeditor/plugins/code/prettify.js" type="text/javascript"></script>     
    <link href="../js/tinybox.css" rel="stylesheet" type="text/css" />
    <script src="../js/tinybox.js" type="text/javascript"></script>
    <script type="text/javascript">
            function showShare() {
                var urlat = "../student/groupshare.aspx";
                TINY.box.show({ iframe: urlat, boxid: 'frameless', width: 600, height: 400, fixed: false, maskopacity: 60, close: true });
            }
    </script>
   <script src="../js/ruffle.js" type="text/javascript"></script>
	<script type="text/javascript">
		window.RufflePlayer = window.RufflePlayer || {};
		window.RufflePlayer.config = {
			"autoplay": "on",
	}
	</script>

    <link href="https://cdn.bootcdn.net/ajax/libs/tailwindcss/2.2.19/utilities.min.css" rel="stylesheet">
    <style>
        .scm-topbar {
            position: sticky; top: 0; z-index: 50; width: 100%;
            background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 40%, #1d4ed8 100%);
            border-bottom: 1px solid rgba(59, 130, 246, 0.2);
            box-shadow: 0 4px 24px -2px rgba(15, 23, 42, 0.25), 0 0 0 1px rgba(59, 130, 246, 0.08);
            transition: all 0.3s ease;
            color: #f1f5f9;
        }
        .scm-topbar::after {
            content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(96,165,250,0.4), rgba(147,197,253,0.5), rgba(96,165,250,0.4), transparent);
        }
        /* Override global a { color: inherit } so links pick up light color from header */
        .scm-topbar a, .scm-topbar a:link, .scm-topbar a:visited { color: inherit; text-decoration: none; }
        .scm-topbar-inner {
            margin: 0 auto; padding: 0 1rem; min-height: 64px;
            display: flex; align-items: center; gap: 1rem; position: relative;
        }
        @media (min-width: 640px) { .scm-topbar-inner { padding: 0 1.5rem; } }
        @media (min-width: 1024px) { .scm-topbar-inner { padding: 0 2rem; } }
        .scm-topbar-brand {
            display: flex; align-items: center; gap: 0.625rem; flex-shrink: 0; text-decoration: none;
        }
        .scm-topbar-logo {
            width: 36px; height: 36px; border-radius: 10px;
            background: rgba(255,255,255,0.12); backdrop-filter: blur(12px);
            display: flex; align-items: center; justify-content: center;
            color: #93c5fd; flex-shrink: 0;
            border: 1px solid rgba(147,197,253,0.2);
        }
        .scm-topbar-logo svg { width: 18px; height: 18px; }
        .scm-topbar-title {
            font-size: 1rem; font-weight: 800; color: #f1f5f9;
            letter-spacing: 0.04em; white-space: nowrap;
            text-shadow: 0 1px 3px rgba(0,0,0,0.3);
        }
        @media (min-width: 640px) { .scm-topbar-title { font-size: 1.125rem; } }
        .scm-topbar-sep {
            width: 1px; height: 28px; background: rgba(148,163,184,0.25); flex-shrink: 0;
        }
        /* Menu nav area */
        .scm-menu-wrap {
            flex: 1; display: flex; align-items: center;
            overflow-x: auto; overflow-y: hidden;
            scrollbar-width: none; -ms-overflow-style: none;
        }
        .scm-menu-wrap::-webkit-scrollbar { display: none; }
        /* Force asp:Menu rendered links to be white (overrides StyleSheet.css a{color:inherit}) */
        .scm-menu-wrap a, .scm-menu-wrap a:link, .scm-menu-wrap a:visited {
            color: #e2e8f0 !important; text-decoration: none !important;
        }
        .scm-menu-wrap a:hover { color: #ffffff !important; }
        .custom-menu-wrapper table { margin: 0; }
        .custom-menu-wrapper table td { padding: 0 2px; }
    </style>
</head>
<body onload="prettyPrint(); " class="bg-slate-50 font-sans text-slate-800 antialiased selection:bg-indigo-100 selection:text-indigo-900 overflow-x-hidden">
    <form id="form1" runat="server">
        <div class="min-h-screen flex flex-col relative w-full max-w-[100vw]">
            <!-- Dynamic Banner container (updated for modern fit) -->
            <div class="banner absolute top-0 inset-x-0 h-48 sm:h-64 bg-gradient-to-b from-indigo-100/60 to-transparent -z-10 bg-cover bg-center" style="opacity: 0.35; mix-blend-mode: multiply;"></div>

            <!-- Modern Topbar -->
            <header class="scm-topbar">
                <div class="scm-topbar-inner custom-menu-wrapper">
                    <!-- Brand -->
                    <a href="../student/myinfo.aspx" class="scm-topbar-brand">
                        <div class="scm-topbar-logo">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                        </div>
                        <span class="scm-topbar-title hidden sm:inline"><%= SiteTitle %></span>
                    </a>

                    <div class="scm-topbar-sep hidden sm:block"></div>

                    <!-- Dynamic Course Menu -->
                    <div class="scm-menu-wrap">
                        <asp:Menu ID="Menuact" runat="server" Orientation="Horizontal" CssClass="flex flex-nowrap items-center min-w-max space-x-1 sm:space-x-2 py-1" ForeColor="#e2e8f0">
                            <StaticSelectedStyle BackColor="rgba(255,255,255,0.2)" ForeColor="#ffffff" />
                            <StaticHoverStyle BackColor="rgba(255,255,255,0.12)" ForeColor="#ffffff" />
                            <StaticMenuItemStyle CssClass="px-3 sm:px-4 py-2 font-semibold text-[13px] sm:text-[14px] transition-all duration-200 ease-out rounded-xl whitespace-nowrap hover:bg-white/10" />
                        </asp:Menu>
                    </div>
                </div>
            </header>

            <!-- Main Content Area -->
            <main class="flex-1 w-full mx-auto p-3 sm:p-6 lg:p-8 z-10 box-border">
                <div class="path mb-2 text-sm text-slate-500 hidden"></div>
                <div class="bg-white rounded-[1.25rem] shadow-sm border border-slate-200/60 p-4 sm:p-8 min-h-[calc(100vh-10rem)] relative w-full overflow-hidden">
                    <asp:contentplaceholder id="Cpcm" runat="server"></asp:contentplaceholder>
                </div>
            </main>
        </div>
    </form>   

    <script type="text/javascript" >
	    var cbanner = "<%=Cbanner %>";
	    if (cbanner != "") {
	        var bannerurl = "url("+cbanner+")";
	        $(".banner").css("background-image", bannerurl);
            $(".banner").css("opacity", "0.15"); /* soften custom images so text is readable */
	    }
    </script>
</body>
</html>
