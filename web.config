<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appSettings>
    <add key="Homework" value="~/homework/" />
    <!-- 禁用 ASP.NET 文件监控，解决 FileSystemWatcher 阻塞 -->
    <add key="aspnet:DisableFileSystemWatcher" value="true" />
    <!-- 禁用自动重新编译 -->
    <add key="aspnet:EnableBatchCompilation" value="false" />
  </appSettings>
  <connectionStrings>
    <!-- 
      请将下面192.168.1.7更改为你的数据库服务器名称或IP地址，这段中的learnsite更改为你创建的数据库名称和Zhou!12345更改为你的数据库密码：
     httpRuntime maxRequestLength - 控制ASP.NET层面的请求大小（单位：KB）
     requestLimits maxAllowedContentLength - 控制IIS层面的请求大小（单位：bytes）
     -->
    <remove name="SqlServer" />
    <add name="SqlServer" providerName="System.Data.SqlClient" connectionString="Data Source=127.0.0.1,1433;Initial Catalog=learnsite;uid=sa;pwd=YourStrong!Passw0rd;" />
  </connectionStrings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" optimizeCompilations="true" batch="false" numRecompilesBeforeAppRestart="256">
      <assemblies>
        <add assembly="System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
        <add assembly="System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
        <add assembly="System.Data, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
        <add assembly="System.Core, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
        <add assembly="System.Data.DataSetExtensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
        <add assembly="System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
        <add assembly="System.Xml, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
        <add assembly="System.Xml.Linq, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
      </assemblies>
    </compilation>
    <authentication mode="Windows" />
    <sessionState mode="InProc" timeout="720" />
    <httpRuntime maxRequestLength="204800" executionTimeout="3600" enableVersionHeader="false" requestValidationMode="2.0" targetFramework="4.8" maxQueryStringLength="2048" maxUrlLength="4096" requestPathInvalidCharacters="" />
    <machineKey validation="HMACSHA256" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="zh-CN" uiCulture="zh-CN" />
    <pages controlRenderingCompatibilityVersion="4.8" clientIDMode="Predictable" validateRequest="false" enableEventValidation="true" viewStateEncryptionMode="Auto" />
  </system.web>
  <system.webServer>
    <!-- 增加请求限制 -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="209715200" />
        <!-- 200MB -->
      </requestFiltering>
    </security>
    <defaultDocument>
      <files>
        <add value="index.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>