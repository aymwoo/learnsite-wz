                    </nav>
                    <div class="py-4 px-3 bg-slate-50 border-t border-slate-200 text-center cursor-pointer hover:bg-slate-100 transition-colors group" onclick="HideMenu()">
                        <asp:Label ID="LabelVer" runat="server" CssClass="text-[11px] text-slate-400 font-mono group-hover:text-slate-600 transition-colors"></asp:Label>
                    </div>
                </aside>

                <!-- Content Area -->
                <main class="flex-1 overflow-y-auto bg-slate-50/50 p-4 md:p-6 lg:p-8 relative custom-scrollbar">
                    <div class="mx-auto min-h-full w-full max-w-[1600px]">
                        <div class="bg-white shadow-sm ring-1 ring-slate-200/50 rounded-2xl min-h-[calc(100vh-8rem)] overflow-hidden">
                            <asp:ContentPlaceHolder id="Content" runat="server">
                            </asp:ContentPlaceHolder>
                        </div>
                    </div>
                </main>
            <div onclick="HideMenu()">
                <asp:Label ID="LabelVer" runat="server" Font-Size="8pt"></asp:Label>
            </div>
        </div>
        <style type="text/css">
            html, body, #form1 {
                max-width: 100vw;
                overflow-x: hidden;
            }
            main .course-hero-content,
            main .course-old-hero-content,
            main .course-create-hero-content,
            main .course-import-hero-content,
            main .course-edit-hero-content,
            main .content-add-hero-content,
            main .admin-form-hero-content,
            main .course-show-hero-content,
            main [class$='-hero-content'],
            main [class*=' hero-content'],
            main [class$='__hero-content'],
            main [class*=' hero__content'] {
                text-align: left !important;
            }
            main .course-title,
            main .course-old-title,
            main .course-create-title,
            main .course-import-title,
            main .course-edit-title,
            main .content-add-title,
            main .admin-form-title,
            main .course-show-title,
            main [class$='-hero__title'],
            main [class*=' hero__title'],
            main [class$='-hero-title'],
            main [class*=' hero-title'],
            main .survey-settings-title,
            main .survey-settings-toolbar-title,
            main .typing-admin-title {
                color: #ffffff !important;
                text-align: left !important;
            }
            main .course-subtitle,
            main .course-old-subtitle,
            main .course-create-subtitle,
            main .course-import-subtitle,
            main .course-edit-subtitle,
            main .content-add-subtitle,
            main .admin-form-subtitle,
            main [class$='-hero__subtitle'],
            main [class*=' hero__subtitle'],
            main [class$='-hero-subtitle'],
            main [class*=' hero-subtitle'],
            main .survey-settings-subtitle,
            main .typing-admin-subtitle {
                color: rgba(255, 255, 255, 0.88) !important;
                text-align: left !important;
            }
            main .course-eyebrow,
            main .course-old-eyebrow,
            main .course-create-eyebrow,
            main .course-import-eyebrow,
            main .course-edit-eyebrow,
            main .content-add-eyebrow,
            main .admin-form-eyebrow,
            main [class$='-hero__eyebrow'],
            main [class*=' hero__eyebrow'],
            main .survey-settings-toolbar-eyebrow,
            main .presurvey-toolbar__eyebrow,
            main .typing-admin-eyebrow {
                text-align: left !important;
            }
            /* Reset Sidebar legacy styles */
            #MenuDiv ul, #MenuDiv li {
                list-style: none !important;
                list-style-type: none !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            #MenuDiv a, #MenuDiv a:hover, #MenuDiv a:visited {
                text-decoration: none !important;
            }
            #MenuDiv a {
                color: #64748b !important; /* text-slate-500 */
            }
            #MenuDiv a:hover {
                color: #4f46e5 !important; /* text-indigo-600 */
            }
            /* Active nav item */
            #MenuDiv a.nav-item.is-active {
                background: #eef2ff !important;
                color: #4f46e5 !important;
            }
            #MenuDiv a.nav-item.is-active svg {
                color: #4f46e5;
            }
            .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
            .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
            .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
            .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        </style>
        <script type="text/javascript">
        (function () {
            // Map each data-section value to page filename prefixes that belong to it
            var sectionMap = {
                'start':      ['start'],
                'course':     ['course'],
                'gauge':      ['gauge'],
                'works':      ['works', 'workcheck', 'worklist'],
                'signin':     ['signin'],
                'student':    ['student', 'stuinfo', 'stulist'],
                'soft':       ['soft', 'softlist'],
                'aiprovider': ['aiprovider', 'aiconfig'],
                'systeminfo': ['systeminfo', 'sysconfig']
            };

            var path = window.location.pathname.toLowerCase();
            var file = path.substring(path.lastIndexOf('/') + 1).replace(/\.aspx.*$/, '');

            var items = document.querySelectorAll('#MenuDiv a.nav-item');
            for (var i = 0; i < items.length; i++) {
                var section = items[i].getAttribute('data-section');
                if (!section) continue;
                var prefixes = sectionMap[section] || [section];
                for (var j = 0; j < prefixes.length; j++) {
                    if (file === prefixes[j] || file.indexOf(prefixes[j]) === 0) {
                        items[i].classList.add('is-active');
                        break;
                    }
                }
            }
        })();
        </script>
    </form>
</body>
</html>
