<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Teach.master.cs" Inherits="Teach" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>信息科技教师网站</title>
    <link rel="stylesheet" type="text/css" href="../App_Themes/Teacher/StyleSheet.css" />
    <link rel="stylesheet" type="text/css" href="../js/css/tailwind-utilities.css" />
    <script src="../js/MenuCookie.js" type="text/javascript"></script>
    <script src="../js/jquery-1.8.2.min.js" type="text/javascript"></script>
    <script src="../kindeditor/plugins/code/prettify.js" type="text/javascript"></script>
    <script src="../js/ruffle.js" type="text/javascript"></script>
	<script type="text/javascript">
		window.RufflePlayer = window.RufflePlayer || {};
		window.RufflePlayer.config = {
			"autoplay": "on",
	}
	</script>
</head>
<body onload="prettyPrint();" class="bg-gray-50 font-sans text-gray-800">
    <form id="form1" runat="server">
        <div class="min-h-screen flex flex-col">
            <!-- Header -->
            <header class="w-full h-12 bg-gray-800 text-white flex items-center px-4 shadow-md z-10 cursor-pointer" onclick="ShowMenu()">
                <asp:Image ID="Imagelogo" runat="server" ImageUrl="~/images/learnsite.gif" ToolTip="信息技术学习网站 LearnSite &#13;Powered By Asp.net2.0+Sql2005Express &#13;温州水乡设计编写" Height="24px" CssClass="opacity-90 hover:opacity-100 transition-opacity" />
                <span class="ml-4 text-lg font-semibold tracking-wide">信息科技教学平台</span>
            </header>

            <!-- Main Layout: Sidebar + Content -->
            <div class="flex flex-1 overflow-hidden relative">

                <!-- Sidebar -->
                <aside id="MenuDiv" class="w-24 flex-shrink-0 bg-white border-r border-gray-200 shadow-sm flex flex-col z-10 transition-all duration-300">
                    <nav class="flex-1 overflow-y-auto py-4">
                        <ul class="flex flex-col space-y-1">
                            <li><a href="../teacher/start.aspx" class="block py-3 text-center text-gray-600 hover:bg-blue-50 hover:text-blue-600 hover:border-l-4 hover:border-blue-600 transition-all text-sm font-medium">上课</a></li>
                            <li><a href="../teacher/course.aspx" class="block py-3 text-center text-gray-600 hover:bg-blue-50 hover:text-blue-600 hover:border-l-4 hover:border-blue-600 transition-all text-sm font-medium">备课</a></li>
                            <li><a href="../teacher/gauge.aspx" class="block py-3 text-center text-gray-600 hover:bg-blue-50 hover:text-blue-600 hover:border-l-4 hover:border-blue-600 transition-all text-sm font-medium">量规</a></li>
                            <li><a href="../teacher/works.aspx" class="block py-3 text-center text-gray-600 hover:bg-blue-50 hover:text-blue-600 hover:border-l-4 hover:border-blue-600 transition-all text-sm font-medium">作品</a></li>
                            <li><a href="../teacher/signin.aspx" class="block py-3 text-center text-gray-600 hover:bg-blue-50 hover:text-blue-600 hover:border-l-4 hover:border-blue-600 transition-all text-sm font-medium">签到</a></li>
                            <li><a href="../teacher/student.aspx" class="block py-3 text-center text-gray-600 hover:bg-blue-50 hover:text-blue-600 hover:border-l-4 hover:border-blue-600 transition-all text-sm font-medium">学生</a></li>
                            <li><a href="../teacher/typer.aspx" class="block py-3 text-center text-gray-600 hover:bg-blue-50 hover:text-blue-600 hover:border-l-4 hover:border-blue-600 transition-all text-sm font-medium">中文</a></li>
                            <li><a href="../teacher/typechinese.aspx" class="block py-3 text-center text-gray-600 hover:bg-blue-50 hover:text-blue-600 hover:border-l-4 hover:border-blue-600 transition-all text-sm font-medium">拼音</a></li>
                            <li><a href="../teacher/soft.aspx" class="block py-3 text-center text-gray-600 hover:bg-blue-50 hover:text-blue-600 hover:border-l-4 hover:border-blue-600 transition-all text-sm font-medium">资源</a></li>
                            <li><a href="../teacher/infomation.aspx" class="block py-3 text-center text-gray-600 hover:bg-blue-50 hover:text-blue-600 hover:border-l-4 hover:border-blue-600 transition-all text-sm font-medium">信息</a></li>
                            <li><a href="../teacher/systeminfo.aspx" class="block py-3 text-center text-gray-600 hover:bg-blue-50 hover:text-blue-600 hover:border-l-4 hover:border-blue-600 transition-all text-sm font-medium">状态</a></li>
                            <li><a href="../teacher/helper.aspx" class="block py-3 text-center text-gray-600 hover:bg-blue-50 hover:text-blue-600 hover:border-l-4 hover:border-blue-600 transition-all text-sm font-medium">帮助</a></li>
                        </ul>
                    </nav>
                    <div class="py-3 text-center bg-gray-100 text-gray-500 text-xs cursor-pointer hover:bg-gray-200 transition-colors" onclick="HideMenu()">
                        <asp:Label ID="LabelVer" runat="server"></asp:Label>
                    </div>
                </aside>

                <!-- Content Area -->
                <main class="flex-1 overflow-y-auto bg-gray-50 p-6 relative">
                    <div class="max-w-7xl mx-auto bg-white shadow-sm rounded-lg border border-gray-100 min-h-full">
                        <asp:ContentPlaceHolder id="Content" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                </main>
            </div>
        </div>
    </form>
</body>
</html>
