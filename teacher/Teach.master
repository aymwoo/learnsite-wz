<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Teach.master.cs" Inherits="Teach" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>信息科技教师网站</title>
    <link rel="stylesheet" type="text/css" href="../App_Themes/Teacher/StyleSheet.css" />
    <link rel="stylesheet" type="text/css" href="../App_Themes/Teacher/course-workspace.css" />
    <link rel="stylesheet" type="text/css" href="../App_Themes/Teacher/course-content-add.css" />
    <link rel="stylesheet" type="text/css" href="../js/css/tailwind-utilities-2.2.19.min.css" />
    <script src="../js/MenuCookie.js" type="text/javascript"></script>
    <script src="../js/jquery-1.8.2.min.js" type="text/javascript"></script>
    <script src="../kindeditor/plugins/code/prettify.js" type="text/javascript"></script>
    <script src="../js/ruffle.js" type="text/javascript"></script>
	<script type="text/javascript">
		window.RufflePlayer = window.RufflePlayer || {};
		window.RufflePlayer.config = {
			"autoplay": "on",
	}
	</script>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body onload="prettyPrint();" class="bg-slate-50 font-sans text-slate-800 antialiased selection:bg-indigo-100 selection:text-indigo-900">
    <form id="form1" runat="server">
        <div class="min-h-screen flex flex-col">
            <!-- Header -->
            <header class="w-full max-w-full h-16 bg-gradient-to-r from-indigo-900 to-indigo-700 text-white flex items-center justify-between px-3 sm:px-6 shadow-md z-20 relative" style="box-sizing: border-box; overflow: hidden;">
                <div class="flex items-center cursor-pointer group min-w-0 flex-shrink transition-all" onclick="ShowMenu()">
                    <span class="text-xl sm:text-2xl font-black tracking-wider text-white drop-shadow-md truncate hover:text-indigo-100 transition-colors"><%= SiteTitle %></span>
                </div>
                <div class="flex items-center gap-2 text-sm font-medium text-indigo-100 flex-shrink min-w-0 ml-2">
                    <div class="flex items-center gap-1.5 sm:gap-2 px-2 sm:px-3 py-1.5 rounded-full bg-indigo-800/50 border border-indigo-400/20 min-w-0 max-w-full">
                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        <span class="truncate text-xs sm:text-sm">教师控制台</span>
                    </div>
                    <asp:HyperLink ID="LogoutBtn" runat="server" NavigateUrl="../teacher/logout.aspx" ToolTip="退出登录"
                       onclick="return confirm('确定要退出登录吗？');"
                       style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:transparent;border:none;color:#fca5a5;transition:all 0.2s;flex-shrink:0;"
                       onmouseover="this.style.color='#f87171';"
                       onmouseout="this.style.color='#fca5a5';">
                        <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                    </asp:HyperLink>
                </div>
            </header>

            <!-- Main Layout: Sidebar + Content -->
