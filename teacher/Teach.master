<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Teach.master.cs" Inherits="Teach" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>信息科技教师网站</title>
    <link rel="stylesheet" type="text/css" href="../App_Themes/Teacher/StyleSheet.css" />
    <link rel="stylesheet" type="text/css" href="../App_Themes/Teacher/course-workspace.css" />
    <link rel="stylesheet" type="text/css" href="../App_Themes/Teacher/course-content-add.css" />
    <link rel="stylesheet" type="text/css" href="../js/css/tailwind-utilities-2.2.19.min.css" />
    <script src="../js/MenuCookie.js" type="text/javascript"></script>
    <script src="../js/jquery-1.8.2.min.js" type="text/javascript"></script>
    <script src="../kindeditor/plugins/code/prettify.js" type="text/javascript"></script>
    <script src="../js/ruffle.js" type="text/javascript"></script>
	<script type="text/javascript">
		window.RufflePlayer = window.RufflePlayer || {};
		window.RufflePlayer.config = {
			"autoplay": "on",
	}
	</script>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body onload="prettyPrint();" class="bg-slate-50 font-sans text-slate-800 antialiased selection:bg-indigo-100 selection:text-indigo-900">
    <form id="form1" runat="server">
        <div class="min-h-screen flex flex-col">
            <!-- Header -->
            <header class="w-full max-w-full bg-white text-slate-800 shadow-[0_4px_20px_-10px_rgba(0,0,0,0.05)] z-20 relative border-b border-slate-200" style="box-sizing: border-box; overflow: hidden;">
                <div class="flex items-center justify-between px-4 sm:px-8 py-3 gap-4">
                    <div class="flex items-center cursor-pointer group min-w-0 flex-shrink transition-all" onclick="ShowMenu()">
                        <div class="flex items-center gap-3">
                            <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-indigo-600 text-white shadow-md shadow-indigo-600/30 group-hover:scale-105 transition-transform">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                            </div>
                            <div class="flex flex-col">
                                <span class="text-xs font-bold uppercase tracking-widest text-indigo-600">LearnSite</span>
                                <span class="text-lg sm:text-xl font-black tracking-tight text-slate-800 truncate transition-colors"><%= SiteTitle %></span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 text-sm font-medium flex-shrink-0 min-w-0">
                        <div class="flex items-center gap-2.5 px-4 py-2 rounded-full bg-slate-50 border border-slate-200 min-w-0 max-w-full shadow-sm">
                            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-indigo-100 text-indigo-600">
                                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                            </span>
                            <div class="min-w-0 flex flex-col justify-center">
                                <span class="truncate text-xs sm:text-sm font-bold text-slate-700">教师控制台</span>
                            </div>
                        </div>
                        <asp:HyperLink ID="LogoutBtn" runat="server" NavigateUrl="../teacher/logout.aspx" ToolTip="退出登录"
                           onclick="return confirm('确定要退出登录吗？');"
                           style="display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:50%;background:#fff1f2;border:1px solid #ffe4e6;color:#ef4444;transition:all 0.2s;flex-shrink:0;"
                           onmouseover="this.style.background='#ffe4e6';this.style.borderColor='#fecdd3';this.style.color='#dc2626';"
                           onmouseout="this.style.background='#fff1f2';this.style.borderColor='#ffe4e6';this.style.color='#ef4444';">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H9m4 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                        </asp:HyperLink>
                    </div>
                </div>
            </header>

            <!-- Main Layout: Sidebar + Content -->
            <div class="flex flex-1 overflow-hidden relative">

                <!-- Modern Sidebar -->
                <aside id="MenuDiv" class="w-24 lg:w-28 flex-shrink-0 bg-slate-50 border-r border-slate-200/80 shadow-[2px_0_12px_-5px_rgba(0,0,0,0.05)] flex flex-col z-10 transition-all duration-300">
                    <div class="px-3 pt-6 pb-2">
                        <div class="rounded-xl bg-white text-slate-800 px-2 py-3 shadow-sm border border-slate-100 flex flex-col items-center justify-center">
                            <div class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Teacher</div>
                            <div class="mt-0.5 text-xs font-bold tracking-wide">Workspace</div>
                        </div>
                    </div>
                    <nav class="flex-1 overflow-y-auto py-3 custom-scrollbar">
                        <ul class="flex flex-col space-y-2 px-3">
                            <li><a href="../teacher/start.aspx" data-section="start" class="nav-item group flex flex-col items-center py-3 px-2 rounded-xl text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-all duration-200">
                                <svg class="w-6 h-6 mb-1.5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5v4m8-4v4"></path><rect x="4" y="7" width="16" height="12" rx="2"></rect><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6"></path></svg>
                                <span class="text-[13px] font-semibold tracking-wide">上课</span>
                            </a></li>
                            <li><a href="../teacher/course.aspx" data-section="course" class="nav-item group flex flex-col items-center py-3 px-2 rounded-xl text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-all duration-200">
                                <svg class="w-6 h-6 mb-1.5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5h7a3 3 0 0 1 3 3v11H7a3 3 0 0 0-3 3z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 5h-7a3 3 0 0 0-3 3v11h7a3 3 0 0 1 3 3z"></path></svg>
                                <span class="text-[13px] font-semibold tracking-wide">备课</span>
                            </a></li>
                            <li><a href="../teacher/gauge.aspx" data-section="gauge" class="nav-item group flex flex-col items-center py-3 px-2 rounded-xl text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-all duration-200">
                                <svg class="w-6 h-6 mb-1.5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5h14v14H5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 9h6M9 12h6M9 15h4"></path></svg>
                                <span class="text-[13px] font-semibold tracking-wide">量规</span>
                            </a></li>
                            <li><a href="../teacher/works.aspx" data-section="works" class="nav-item group flex flex-col items-center py-3 px-2 rounded-xl text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-all duration-200">
                                <svg class="w-6 h-6 mb-1.5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"></rect><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 14 3-3 2 2 3-4"></path></svg>
                                <span class="text-[13px] font-semibold tracking-wide">作品</span>
                            </a></li>
                            <li><a href="../teacher/teachermanage.aspx" data-section="manage" class="nav-item group flex flex-col items-center py-3 px-2 rounded-xl text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-all duration-200">
                                <svg class="w-6 h-6 mb-1.5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16M8 4v4M16 10v4M12 16v4"></path></svg>
                                <span class="text-[13px] font-semibold tracking-wide">管理</span>
                            </a></li>
                            <li><a href="../teacher/soft.aspx" data-section="soft" class="nav-item group flex flex-col items-center py-3 px-2 rounded-xl text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-all duration-200">
                                <svg class="w-6 h-6 mb-1.5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16"></path><rect x="4" y="7" width="16" height="12" rx="2"></rect><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 11h6M9 15h4"></path></svg>
                                <span class="text-[13px] font-semibold tracking-wide">资源</span>
                            </a></li>
                            <li><a href="../teacher/aiconfig.aspx" data-section="aiprovider" class="nav-item group flex flex-col items-center py-3 px-2 rounded-xl text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-all duration-200">
                                <svg class="w-6 h-6 mb-1.5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="6" cy="12" r="2"></circle><circle cx="18" cy="6" r="2"></circle><circle cx="18" cy="18" r="2"></circle><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h4m2.5-4.5-3 3m3 3-3-3"></path></svg>
                                <span class="text-[13px] font-semibold tracking-wide">AI</span>
                            </a></li>

                            <li><a href="../teacher/typer.aspx" data-section="typing" class="nav-item group flex flex-col items-center py-3 px-2 rounded-xl text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-all duration-200">
                                <svg class="w-6 h-6 mb-1.5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M6 11h2m2 0h2m2 0h2m2 0h2M5 17h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                <span class="text-[13px] font-semibold tracking-wide">打字</span>
                            </a></li>

                            <li><a href="../teacher/infomation.aspx" data-section="aiprovider" class="nav-item group flex flex-col items-center py-3 px-2 rounded-xl text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-all duration-200">
                                <svg class="w-6 h-6 mb-1.5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 3h7l5 5v13H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 3v5h5"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6M9 17h4"></path></svg>
                                <span class="text-[13px] font-semibold tracking-wide">信息</span>
                            </a></li>

                            <li><a href="../teacher/helper.aspx" data-section="aiprovider" class="nav-item group flex flex-col items-center py-3 px-2 rounded-xl text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-all duration-200">
                                <svg class="w-6 h-6 mb-1.5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.1 9a3 3 0 1 1 5.8 1c-.6 1.1-1.9 1.7-2.4 2.4-.3.4-.5.8-.5 1.6"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 17h.01"></path></svg>
                                <span class="text-[13px] font-semibold tracking-wide">帮助</span>
                            </a></li>

                            <li><a href="../exam/examlist.aspx" data-section="aiprovider" class="nav-item group flex flex-col items-center py-3 px-2 rounded-xl text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-all duration-200">
                                <svg class="w-6 h-6 mb-1.5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 3h7l5 5v8a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 3v5h5"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 13 2 2 4-4"></path></svg>
                                <span class="text-[13px] font-semibold tracking-wide">考试</span>
                            </a></li>


                            <li><a href="../teacher/systeminfo.aspx" data-section="systeminfo" class="nav-item group flex flex-col items-center py-3 px-2 rounded-xl text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-all duration-200">
                                <svg class="w-6 h-6 mb-1.5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"></circle><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2"></path></svg>
                                <span class="text-[13px] font-semibold tracking-wide">状态</span>
                            </a></li>
                        </ul>
                    </nav>
                    <div class="px-3 pb-4 pt-3 border-t border-slate-200 bg-slate-50">
                        <div class="rounded-xl border border-slate-100 bg-white px-2 py-3 text-center cursor-pointer shadow-sm hover:border-indigo-100 hover:bg-indigo-50/30 transition-all group" onclick="HideMenu()">
                            <div class="text-[9px] uppercase tracking-widest text-slate-400 font-semibold">Version</div>
                            <asp:Label ID="LabelVer" runat="server" CssClass="mt-0.5 block text-[10px] text-slate-500 font-mono group-hover:text-indigo-600 transition-colors"></asp:Label>
                        </div>
                    </div>
                </aside>

                <!-- Content Area -->
                <main class="flex-1 overflow-y-auto bg-slate-50/50 p-4 md:p-6 lg:p-8 relative custom-scrollbar">
                    <div class="mx-auto min-h-full w-full max-w-[1600px]">
                        <div class="bg-white shadow-sm ring-1 ring-slate-200/50 rounded-2xl min-h-[calc(100vh-8rem)] overflow-hidden">
                            <asp:ContentPlaceHolder id="Content" runat="server">
                            </asp:ContentPlaceHolder>
                        </div>
                    </div>
                </main>
        </div>
        <style type="text/css">
            html, body, #form1 {
                max-width: 100vw;
                overflow-x: hidden;
            }
            main .course-hero-content,
            main .course-old-hero-content,
            main .course-create-hero-content,
            main .course-import-hero-content,
            main .course-edit-hero-content,
            main .content-add-hero-content,
            main .admin-form-hero-content,
            main .course-show-hero-content,
            main [class$='-hero-content'],
            main [class*=' hero-content'],
            main [class$='__hero-content'],
            main [class*=' hero__content'] {
                text-align: left !important;
            }
            main .course-title,
            main .course-old-title,
            main .course-create-title,
            main .course-import-title,
            main .course-edit-title,
            main .content-add-title,
            main .admin-form-title,
            main .course-show-title,
            main [class$='-hero__title'],
            main [class*=' hero__title'],
            main [class$='-hero-title'],
            main [class*=' hero-title'],
            main .survey-settings-title,
            main .survey-settings-toolbar-title,
            main .typing-admin-title {
                color: #ffffff !important;
                text-align: left !important;
            }
            main .course-subtitle,
            main .course-old-subtitle,
            main .course-create-subtitle,
            main .course-import-subtitle,
            main .course-edit-subtitle,
            main .content-add-subtitle,
            main .admin-form-subtitle,
            main [class$='-hero__subtitle'],
            main [class*=' hero__subtitle'],
            main [class$='-hero-subtitle'],
            main [class*=' hero-subtitle'],
            main .survey-settings-subtitle,
            main .typing-admin-subtitle {
                color: rgba(255, 255, 255, 0.88) !important;
                text-align: left !important;
            }
            main .course-eyebrow,
            main .course-old-eyebrow,
            main .course-create-eyebrow,
            main .course-import-eyebrow,
            main .course-edit-eyebrow,
            main .content-add-eyebrow,
            main .admin-form-eyebrow,
            main [class$='-hero__eyebrow'],
            main [class*=' hero__eyebrow'],
            main .survey-settings-toolbar-eyebrow,
            main .presurvey-toolbar__eyebrow,
            main .typing-admin-eyebrow {
                text-align: left !important;
            }
            /* Reset Sidebar legacy styles */
            #MenuDiv ul, #MenuDiv li {
                list-style: none !important;
                list-style-type: none !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            #MenuDiv a, #MenuDiv a:hover, #MenuDiv a:visited {
                text-decoration: none !important;
            }
            #MenuDiv a {
                color: #64748b !important; /* text-slate-500 */
                position: relative;
            }
            #MenuDiv a:hover {
                color: #4f46e5 !important; /* text-indigo-600 */
            }
            #MenuDiv a.nav-item {
                border: 1px solid transparent;
            }
            #MenuDiv a.nav-item:hover {
                background: #f8fafc !important;
                border-color: #f1f5f9 !important;
            }
            /* Active nav item */
            #MenuDiv a.nav-item.is-active {
                background: linear-gradient(135deg, #e0e7ff 0%, #eef2ff 100%) !important;
                color: #4338ca !important;
                border-color: #c7d2fe !important;
                box-shadow: 0 4px 12px -4px rgba(79,70,229,0.2) !important;
            }
            #MenuDiv a.nav-item.is-active svg {
                color: #4f46e5;
            }
            #MenuDiv a.nav-item.is-active::after {
                content: "";
                position: absolute;
                left: 0px;
                top: 50%;
                transform: translateY(-50%);
                height: 24px;
                width: 4px;
                border-radius: 0 4px 4px 0;
                background: linear-gradient(180deg, #4f46e5 0%, #6366f1 100%);
            }
            .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
            .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
            .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
            .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        </style>
        <script type="text/javascript">
        (function () {
            // Map each data-section value to page filename prefixes that belong to it
            var sectionMap = {
                'start':      ['start'],
                'course':     ['course'],
                'gauge':      ['gauge'],
                'works':      ['works', 'workcheck', 'worklist'],
                'manage':     ['teachermanage', 'student', 'studentstats', 'signinmanage', 'postclasscheck', 'check', 'seatmanage', 'studentnumedit', 'honorboardmanage', 'skdjshow'],
                'soft':       ['soft', 'softlist'],
                'typing':     ['typer', 'type', 'typechinese', 'printtyper'],
                'aiprovider': ['aiprovider', 'aiconfig'],
                'systeminfo': ['systeminfo', 'sysconfig']
            };

            var path = window.location.pathname.toLowerCase();
            var file = path.substring(path.lastIndexOf('/') + 1).replace(/\.aspx.*$/, '');

            var items = document.querySelectorAll('#MenuDiv a.nav-item');
            for (var i = 0; i < items.length; i++) {
                var section = items[i].getAttribute('data-section');
                if (!section) continue;
                var prefixes = sectionMap[section] || [section];
                for (var j = 0; j < prefixes.length; j++) {
                    if (file === prefixes[j] || file.indexOf(prefixes[j]) === 0) {
                        items[i].classList.add('is-active');
                        break;
                    }
                }
            }
        })();
        </script>
    </form>
</body>
</html>
