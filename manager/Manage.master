                    <asp:Image ID="Image1" runat="server" ImageUrl="~/images/learnsite.gif" ToolTip="信息技术学习平台 LearnSite &#13;Powered By Asp.net+Sql2005+Js &#13;温州水乡设计编写" Height="24px" CssClass="opacity-95" />
